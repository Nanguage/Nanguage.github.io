---
import Base from '../layouts/Base.astro';
import Social from '../components/Social.astro';
import { site } from '../data/site';
import { projects } from '../data/projects';
import { news } from '../data/news';
import { publications } from '../data/publications';
import { topics } from '../data/research';
import { photos } from '../data/photos';

const topTopics = topics.slice(0, 3);
const homeSoftwareNames = ['PantheonOS', 'Virtual Embryo', 'U-FISH'];
const homeSoftware = homeSoftwareNames
  .map((n) => projects.find((p) => p.name === n))
  .filter((p): p is (typeof projects)[number] => Boolean(p));
const lifePhotos = photos.slice(0, 3);
---

<Base>
  <header class="masthead">
    <div class="masthead__inner">
      <img class="masthead__photo" src={site.photo} alt={site.name} width="132" height="132" />
      <div class="masthead__body">
        <h1 class="masthead__name">{site.name}</h1>
        <p class="masthead__role">{site.role}</p>
        <p class="masthead__affil">
          <a href={site.affiliationUrl}>{site.affiliation}</a>{site.location && ` · ${site.location}`}
        </p>
        <div class="masthead__meta">
          <Social />
          {
            site.scholarMetrics && (
              <span class="metrics">
                <a href={site.scholar} target="_blank" rel="noopener">Google Scholar</a> ·
                {site.scholarMetrics.citations} citations · h-index {site.scholarMetrics.hIndex}
              </span>
            )
          }
        </div>
      </div>
    </div>
    <hr class="masthead__rule" />
  </header>

  <div class="lead">
    <p>
      I am a postdoctoral scholar in <a href="https://www.devo-evo.com/">Xiaojie Qiu's lab</a> in the
      <a href="https://genetics.stanford.edu/">Department of Genetics at Stanford</a>. During my PhD I
      developed new technologies for 3D genomics and imaging-based spatial transcriptomics.
    </p>
  </div>

  <div class="vision">
    <div class="vision__body">
      <p class="vision__label">Research vision</p>
      <p class="vision__text">
        My goal is to automate the toil of biological discovery: I build evolvable multi-agent systems that
        plan and run experiments, analyze the data, and test hypotheses against virtual models of biology —
        closing the loop from a scientist's question to the result. I'm working toward a world where
        biologists spend their time asking the right questions and judging what matters, and the machinery
        of discovery runs itself.
      </p>
    </div>
    <div class="vision__fig">
      <img class="is-light" src="/vision.png" alt="" loading="lazy" />
      <img class="is-dark" src="/vision-dark.png" alt="" loading="lazy" />
    </div>
  </div>

  <section class="sec">
    <div class="sec__label">
      Research
      <a class="more" href="/research/">All {publications.length} →</a>
    </div>
    <div class="sec__body">
      <div class="topic-list">
        {
          topTopics.map((t) => (
            <a class="topic-row" href="/research/">
              {t.image && (
                <>
                  <img class="topic-row__img is-light" src={t.image} alt="" loading="lazy" />
                  <img class="topic-row__img is-dark" src={t.image.replace('.png', '-dark.png')} alt="" loading="lazy" />
                </>
              )}
              <div>
                <div class="topic-row__title">{t.title}</div>
                <div class="topic-row__desc">{t.desc}</div>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="sec__label">
      Software
      <a class="more" href="/software/">All →</a>
    </div>
    <div class="sec__body">
      <div class="topic-list">
        {
          homeSoftware.map((p) => (
            <a class="topic-row" href={p.url} target="_blank" rel="noopener">
              {p.image && (
                <>
                  <img class="topic-row__img is-light" src={p.image} alt="" loading="lazy" />
                  <img class="topic-row__img is-dark" src={p.image.replace('.png', '-dark.png')} alt="" loading="lazy" />
                </>
              )}
              <div>
                <div class="topic-row__title">{p.name}</div>
                <div class="topic-row__desc">{p.tagline ?? p.desc}</div>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  {
    news.length > 0 && (
      <section class="sec">
        <div class="sec__label">News</div>
        <div class="sec__body">
          <ul class="news">
            {news.map((n) => (
              <li>
                <time>{n.date}</time>
                <div class="news__body">
                  <p set:html={n.html} />
                </div>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <section class="sec">
    <div class="sec__label">
      Life
      <a class="more" href="/life/">More →</a>
    </div>
    <div class="sec__body">
      <div class="gallery">
        {
          lifePhotos.map((ph) => (
            <figure>
              <img src={ph.src} alt={ph.alt ?? ph.caption ?? ''} loading="lazy" />
              {ph.caption && <figcaption>{ph.caption}</figcaption>}
            </figure>
          ))
        }
      </div>
    </div>
  </section>
</Base>
