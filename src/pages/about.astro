---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---

<Base title="About">
  <div class="page reading">
    <h1 class="page-title">About</h1>
    <div class="prose">
      <p>
        I am a postdoctoral scholar in <a href="https://www.devo-evo.com/">Xiaojie Qiu's lab</a> in the
        <a href="https://genetics.stanford.edu/">Department of Genetics</a> at Stanford University.
        My current work focuses on building agentic systems for scientific discovery. I did my PhD in
        <a href="https://gangcaolab.lhs.suat-sz.edu.cn/cg/">Gang Cao's lab</a>, where I worked on
        microscopy image analysis.
      </p>
      <p>Outside research I hike, fish, garden, travel, and build the occasional small web tool.</p>

      <h2>Research interests</h2>
      <ul>
        <li>Agentic systems for scientific discovery</li>
        <li>Microscopy image analysis</li>
        <li>Open-source, reproducible scientific software</li>
      </ul>

      <h2>Contact</h2>
      <ul>
        <li><strong>Email</strong> — <a href={`mailto:${site.email}`}>{site.email}</a></li>
        <li><strong>GitHub</strong> — <a href={`https://github.com/${site.github}`}>@{site.github}</a></li>
        <li><strong>Twitter / X</strong> — <a href={`https://twitter.com/${site.twitter}`}>@{site.twitter}</a></li>
        <li><strong>WeChat 公众号</strong> — BaseOverflow</li>
      </ul>
    </div>
  </div>
</Base>
