---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---

<Base title="About">
  <div class="page">
    <h1 class="page-title">About</h1>
    <div class="prose">
      <p>
        I am a postdoctoral scholar in Xiaojie Qiu's lab in the
        <a href="https://genetics.stanford.edu/">Department of Genetics</a> at Stanford University.
        I work on spatial omics, microscopy image analysis, and open-source software and agents
        for large biological datasets. Before my postdoc I worked on chromatin architecture (Hi-C)
        and genomics visualization tools.
      </p>
      <p>Outside research I hike, fish, garden, travel, and build the occasional small web tool.</p>

      <h2>Research interests</h2>
      <ul>
        <li>Spatial transcriptomics and microscopy image analysis</li>
        <li>Agents and automation for data-science workflows</li>
        <li>Reproducible, usable scientific software</li>
      </ul>

      <h2>Contact</h2>
      <ul>
        <li><strong>Email</strong> — <a href={`mailto:${site.email}`}>{site.email}</a></li>
        <li><strong>GitHub</strong> — <a href={`https://github.com/${site.github}`}>@{site.github}</a></li>
        <li><strong>Twitter / X</strong> — <a href={`https://twitter.com/${site.twitter}`}>@{site.twitter}</a></li>
        <li><strong>WeChat 公众号</strong> — BaseOverflow</li>
      </ul>
    </div>
  </div>
</Base>
