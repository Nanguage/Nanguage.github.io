---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { site } from '../../data/site';
import { fmtLong } from '../../utils/date';

export async function getStaticPaths() {
  // Only real content posts get pages; `jump` entries just link out.
  const posts = await getCollection('blog', ({ data }) => !data.jump);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Base title={post.data.title} description={post.data.title}>
  <article>
    <header class="post-header">
      <h1>{post.data.title}</h1>
      <div class="post-meta">
        <time datetime={post.data.pubDate.toISOString()}>{fmtLong(post.data.pubDate)}</time>
        {
          post.data.tags.map((t) => (
            <a class="tag-chip" href={`/tags/${t}/`}>
              {t.replace(/-/g, ' ')}
            </a>
          ))
        }
      </div>
    </header>

    <div class="prose">
      <Content />
    </div>

    <a class="back-link" href="/blog/">← All posts</a>

    <div class="comments">
      <script
        is:inline
        src="https://utteranc.es/client.js"
        repo={site.repo}
        issue-term={post.data.title}
        theme="github-light"
        crossorigin="anonymous"
        async></script>
    </div>
  </article>
</Base>
