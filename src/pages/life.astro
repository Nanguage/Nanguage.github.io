---
import Base from '../layouts/Base.astro';
import { photos } from '../data/photos';
---

<Base title="Life" description="Beyond research — hiking, fishing, gardening, and traveling.">
  <div class="page">
    <h1 class="page-title">Life</h1>
    <p class="page-subtitle">Beyond research.</p>
    <div class="prose" style="margin-bottom: 28px; max-width: 60ch;">
      <p>
        When I'm not at a screen I'm usually outdoors — hiking, fishing, gardening (tomatoes,
        cucumbers, strawberries), or traveling somewhere new. A few photos from along the way.
      </p>
    </div>
    <div class="gallery">
      {
        photos.map((ph) => (
          <figure>
            <button
              class="gallery__btn"
              type="button"
              data-src={ph.src}
              data-caption={ph.caption ?? ''}
              aria-label={ph.caption ?? 'Enlarge photo'}
            >
              <img src={ph.src} alt={ph.alt ?? ph.caption ?? ''} loading="lazy" />
            </button>
            {ph.caption && <figcaption>{ph.caption}</figcaption>}
          </figure>
        ))
      }
    </div>
  </div>

  <dialog class="lightbox" id="lightbox">
    <button class="lightbox__close" id="lightbox-close" type="button" aria-label="Close">×</button>
    <img class="lightbox__img" id="lightbox-img" src="" alt="" />
    <p class="lightbox__caption" id="lightbox-caption"></p>
  </dialog>

  <script is:inline>
    (function () {
      var dlg = document.getElementById('lightbox');
      if (!dlg || typeof dlg.showModal !== 'function') return;
      var img = document.getElementById('lightbox-img');
      var cap = document.getElementById('lightbox-caption');
      document.querySelectorAll('.gallery__btn').forEach(function (b) {
        b.addEventListener('click', function () {
          var c = b.getAttribute('data-caption') || '';
          img.setAttribute('src', b.getAttribute('data-src'));
          img.setAttribute('alt', c);
          cap.textContent = c;
          dlg.showModal();
        });
      });
      document.getElementById('lightbox-close').addEventListener('click', function () {
        dlg.close();
      });
      dlg.addEventListener('click', function (e) {
        if (e.target === dlg) dlg.close();
      });
    })();
  </script>
</Base>
