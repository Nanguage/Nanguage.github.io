---
import type { Project } from '../data/projects';
const { project } = Astro.props as { project: Project };
const imageDark = project.image?.replace('.png', '-dark.png');
---
<div class="card">
  {project.image && (
    <a class="card__fig" href={project.url} target="_blank" rel="noopener" aria-label={project.name}>
      <img class="is-light" src={project.image} alt="" loading="lazy" />
      {imageDark && <img class="is-dark" src={imageDark} alt="" loading="lazy" />}
    </a>
  )}
  <div class="card__body">
    <h3 class="card__title">
      <a href={project.url} target="_blank" rel="noopener">{project.name}</a>
    </h3>
    <p class="card__desc">{project.desc}</p>
    <div class="card__meta">
      {project.lang && (
        <span class="lang">
          <span class="dot" style={`background:${project.color ?? '#8f8f8f'}`}></span>{project.lang}
        </span>
      )}
      {project.stars && (
        <span class="stars">
          <svg viewBox="0 0 24 24"><path d="M12 2.6l2.9 5.9 6.5.95-4.7 4.6 1.1 6.45L12 18.9 6.2 21.9l1.1-6.45-4.7-4.6 6.5-.95L12 2.6Z"/></svg>{project.stars}
        </span>
      )}
    </div>
  </div>
</div>
