---
import { site } from '../data/site';
const path = Astro.url.pathname;
const on = (p: string) => (p === '/' ? path === '/' : path.startsWith(p));
---
<nav class="site-nav">
  <div class="container">
    <a class="brand" href="/">{site.name}</a>
    <div class="nav-links">
      <a href="/" class:list={[{ active: path === '/' }]}>Home</a>
      <a href="/projects/" class:list={[{ active: on('/projects') }]}>Projects</a>
      <a href="/blog/" class:list={[{ active: on('/blog') }]}>Blog</a>
      <a href="/about/" class:list={[{ active: on('/about') }]}>About</a>
      <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Toggle dark mode" title="Toggle theme">
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
      </button>
    </div>
  </div>
</nav>
