---
import { site } from '../data/site';
---
<div class="social">
  {site.email && (
    <a href={`mailto:${site.email}`} aria-label="Email" title="Email">
      <svg viewBox="0 0 24 24"><path d="M2 5.5A2.5 2.5 0 0 1 4.5 3h15A2.5 2.5 0 0 1 22 5.5v13a2.5 2.5 0 0 1-2.5 2.5h-15A2.5 2.5 0 0 1 2 18.5v-13Zm2.2-.5 7.8 5.9L19.8 5H4.2ZM20 6.8l-7.4 5.6a1 1 0 0 1-1.2 0L4 6.8V18.5c0 .28.22.5.5.5h15a.5.5 0 0 0 .5-.5V6.8Z"/></svg>
    </a>
  )}
  {site.github && (
    <a href={`https://github.com/${site.github}`} aria-label="GitHub" title="GitHub">
      <svg viewBox="0 0 24 24"><path d="M12 .5A11.5 11.5 0 0 0 .5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.34-1.28-1.7-1.28-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.2 1.77 1.2 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.79 0c2.2-1.5 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.43-2.7 5.4-5.26 5.69.41.36.78 1.05.78 2.12v3.14c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12 11.5 11.5 0 0 0 12 .5Z"/></svg>
    </a>
  )}
  {site.scholar && (
    <a href={site.scholar} aria-label="Google Scholar" title="Google Scholar">
      <svg viewBox="0 0 24 24"><path d="M12 2 1 8.5l11 6.5 9-5.32V16h2V8.5L12 2Z"/><path d="M5 13.18v3.32L12 20l7-3.5v-3.32l-7 4.13-7-4.13Z"/></svg>
    </a>
  )}
  {site.orcid && (
    <a href={`https://orcid.org/${site.orcid}`} aria-label="ORCID" title="ORCID">
      <svg viewBox="0 0 24 24"><path d="M12 0a12 12 0 1 0 0 24 12 12 0 0 0 0-24ZM8.2 6.6a1.1 1.1 0 1 1 0 2.2 1.1 1.1 0 0 1 0-2.2ZM7.3 10.1h1.7v7.3H7.3v-7.3Zm3.4 0h3.3c3.1 0 4.5 2.2 4.5 3.65 0 1.6-1.24 3.65-4.45 3.65h-3.35v-7.3Zm1.7 1.53v4.25h1.5c2.05 0 2.55-1.55 2.55-2.12 0-.93-.6-2.13-2.6-2.13h-1.45Z"/></svg>
    </a>
  )}
  {site.linkedin && (
    <a href={site.linkedin} aria-label="LinkedIn" title="LinkedIn">
      <svg viewBox="0 0 24 24"><path d="M4.98 3.5A2.5 2.5 0 1 1 0 3.5a2.5 2.5 0 0 1 4.98 0ZM.25 8.25h4.5V24h-4.5V8.25Zm7.5 0h4.31v2.15h.06c.6-1.14 2.07-2.34 4.26-2.34 4.56 0 5.4 3 5.4 6.9V24h-4.5v-6.99c0-1.67-.03-3.82-2.33-3.82-2.33 0-2.69 1.82-2.69 3.7V24h-4.5V8.25Z"/></svg>
    </a>
  )}
  {site.twitter && (
    <a href={`https://twitter.com/${site.twitter}`} aria-label="Twitter / X" title="Twitter / X">
      <svg viewBox="0 0 24 24"><path d="M18.24 2.25h3.31l-7.23 8.26 8.5 11.24h-6.66l-5.21-6.82-5.97 6.82H1.66l7.73-8.83L1.25 2.25h6.83l4.71 6.23 5.45-6.23Zm-1.16 17.52h1.83L7.01 4.13H5.05l12.03 15.64Z"/></svg>
    </a>
  )}
</div>
